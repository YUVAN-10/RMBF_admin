rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is an active admin
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == "active";
    }
    
    // Helper function to check if the user is an active member
    function isMember() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "active";
    }

    // Admins can do anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Members collection
    match /members/{memberId} {
      allow read: if isMember() || isAdmin();
      // Members can only edit their own profile, but cannot change their role/status
      allow update: if isAuthenticated() && request.auth.uid == memberId 
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.role == resource.data.role;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isMember() || isAdmin();
    }

    // Meetings collection
    match /meetings/{meetingId} {
      allow read: if isMember() || isAdmin();
      
      // Attendance subcollection
      match /attendance/{userId} {
        allow read: if isMember() || isAdmin();
        // Members can mark their own attendance
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // RToR collection
    match /rToR/{rToRId} {
      allow read: if isMember() || isAdmin();
      // Members can create interactions they are part of
      allow create: if isAuthenticated() && 
                    (request.resource.data.fromUserId == request.auth.uid || 
                     request.resource.data.toUserId == request.auth.uid);
    }

    // Thank Notes collection
    match /thankNotes/{noteId} {
      allow read: if isMember() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
    }

    // Admin profiles (only readable by themselves, or other admins)
    match /admins/{adminId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId);
    }
  }
}
