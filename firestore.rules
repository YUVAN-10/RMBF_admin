rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is an active admin
    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == "active";
    }
    
    // Helper function to check if the user is an active member
    // Member docs store status as "Active"/"Inactive" (see memberStatuses in
    // src/data/membersData.js and MemberForm.jsx) — matching that casing
    // exactly is what makes disabling a member (status -> "Inactive") here
    // actually cut off their access to every isMember()-gated collection.
    function isMember() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == "Active";
    }

    // Admins can do anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Members collection
    match /members/{memberId} {
      allow read: if isMember() || isAdmin();
      // Members can only edit their own profile, but cannot change their role/status
      allow update: if isAuthenticated() && request.auth.uid == memberId 
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.role == resource.data.role;
    }

    // Points Master — the single source of truth for every point value
    // (settings/pointsMaster). Any authenticated user (member or admin) may
    // read it so point calculations always use the current values; only
    // admins may ever write it (top-level admin wildcard rule already
    // grants that, this just keeps everyone else out explicitly).
    match /settings/pointsMaster {
      allow read: if isAuthenticated();
    }

    // Meeting Limits — settings/meetingLimits holds the admin-configurable
    // Power Team Meetings per-term cap (Regular Meetings' cap is fixed in
    // code). Same read-for-any-authenticated-user, admin-only-write pattern
    // as Points Master above.
    match /settings/meetingLimits {
      allow read: if isAuthenticated();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isMember() || isAdmin();
    }

    // Meetings collection
    match /meetings/{meetingId} {
      allow read: if isMember() || isAdmin();
      
      // Attendance subcollection
      match /attendance/{userId} {
        allow read: if isMember() || isAdmin();
        // Members can mark their own attendance
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Power Team Meetings collection (kept fully separate from meetings/)
    match /powerTeamMeetings/{meetingId} {
      allow read: if isMember() || isAdmin();
      // Only admins may create/update/cancel a meeting (covered by the
      // top-level admin wildcard rule above — no member create here).

      // Attendance subcollection, one doc per user (doc ID == userUid)
      match /attendance/{userId} {
        allow read: if isMember() || isAdmin();

        // A member may create ONLY their own attendance doc, exactly once —
        // the deterministic doc ID plus the absence of any update/delete
        // rule below means a repeat scan can never overwrite scannedAt.
        //
        // Eligibility is checked against the meeting's own eligibleMemberIds
        // — a frozen snapshot of that Power Team's roster taken when the
        // meeting was created (see powerTeamMeetingService.js) — not the
        // member's CURRENT Power Team, since membership can change after
        // the meeting was created. Meetings created before this field
        // existed have no eligibleMemberIds, so `in` fails closed and denies
        // the write for those older meetings.
        allow create: if isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.userUid == request.auth.uid &&
          request.resource.data.status == "present" &&
          request.resource.data.scannedAt == request.time &&
          exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
          request.auth.uid in get(/databases/$(database)/documents/powerTeamMeetings/$(meetingId)).data.eligibleMemberIds;

        // No update or delete for anyone but an admin (top-level rule).
      }
    }

    // Member Points collection — per-member, per-calendar-month history.
    // A month's document is never overwritten by later months, so past
    // totals stay intact (see pointsService.js for the awarding logic).
    match /memberPoints/{memberId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == memberId);

      match /months/{monthId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == memberId);

        // Points are only ever meant to be written by the trusted
        // awardPoints() service path, acting as the member themselves.
        // These structural checks stop a client from impersonating another
        // member, writing past the 10,000 monthly cap, decreasing points,
        // tampering with month/maxPoints, or forging the server timestamp —
        // the exact per-activity award amount is enforced by awardPoints()'s
        // transaction, matching the trust model already used for
        // Referrals/attendance in this app.
        // maxPoints is no longer hardcoded to 10000 — it comes from the
        // admin-configurable settings/pointsMaster.monthlyPointLimit at the
        // time a member's month doc is first created (see pointsService.js),
        // so this only bounds it to a sane positive number and keeps points
        // within whatever cap that doc was created with.
        allow create: if isAuthenticated() && request.auth.uid == memberId &&
          request.resource.data.month == monthId &&
          request.resource.data.maxPoints > 0 &&
          request.resource.data.points >= 0 &&
          request.resource.data.points <= request.resource.data.maxPoints &&
          request.resource.data.updatedAt == request.time;

        // Points Master includes deduction activities (Absent, Leave, ...)
        // with negative values, so points may legitimately decrease — the
        // real protection is that it can never leave the [0, maxPoints]
        // range, only the member themselves can write it, and every other
        // field stays immutable.
        allow update: if isAuthenticated() && request.auth.uid == memberId &&
          request.resource.data.month == resource.data.month &&
          request.resource.data.maxPoints == resource.data.maxPoints &&
          request.resource.data.points >= 0 &&
          request.resource.data.points <= request.resource.data.maxPoints &&
          request.resource.data.updatedAt == request.time;

        // Immutable audit log — entries are only ever created alongside a
        // points write, never edited or removed afterward.
        match /transactions/{transactionId} {
          allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == memberId);

          // points != 0 rather than > 0 — deduction activities (Absent,
          // Leave, ...) record a negative amount here too.
          allow create: if isAuthenticated() && request.auth.uid == memberId &&
            request.resource.data.points is number && request.resource.data.points != 0 &&
            request.resource.data.activityType is string &&
            request.resource.data.createdAt == request.time;
        }
      }
    }

    // RToR collection
    match /rToR/{rToRId} {
      allow read: if isMember() || isAdmin();
      // Members can create interactions they are part of
      allow create: if isAuthenticated() && 
                    (request.resource.data.fromUserId == request.auth.uid || 
                     request.resource.data.toUserId == request.auth.uid);
    }

    // Referrals collection (Self Referral + Connect)
    match /referrals/{referralId} {
      allow read: if isMember() || isAdmin();

      // A member may only create a referral where they are the referrer
      // (auth.uid drives identity — createdBy/referrerId cannot be spoofed),
      // the timestamp is server-generated, and every participant is a real member.
      allow create: if isAuthenticated() &&
        request.resource.data.type in ["self", "connect"] &&
        request.resource.data.status == "active" &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByName is string &&
        request.resource.data.referrerId == request.auth.uid &&
        request.resource.data.referredUserId != request.auth.uid &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/members/$(request.resource.data.referredUserId)) &&
        (
          (request.resource.data.type == "self" &&
            request.resource.data.connectorId == null &&
            request.resource.data.connectorName == null) ||
          (request.resource.data.type == "connect" &&
            request.resource.data.connectorId is string &&
            request.resource.data.connectorId != request.auth.uid &&
            request.resource.data.connectorId != request.resource.data.referredUserId &&
            exists(/databases/$(database)/documents/members/$(request.resource.data.connectorId)))
        );

      // No one but an admin (via the top-level rule above) may update or delete a referral.
    }

    // Thank Notes collection
    match /thankNotes/{noteId} {
      allow read: if isMember() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
    }

    // Admin profiles (only readable by themselves, or other admins)
    match /admins/{adminId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId);
    }
  }
}
